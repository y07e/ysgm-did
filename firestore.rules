rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isLoggedIn() {
      return request.auth != null;
    }

    function isAnonymous() {
      return isLoggedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function getUserData() {
      return get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isLoggedIn() && !isAnonymous() &&
        exists(/databases/$(database)/documents/teachers/$(request.auth.uid)) &&
        getUserData().role == 'admin';
    }

    function isTeacher() {
      return isLoggedIn() && !isAnonymous() &&
        exists(/databases/$(database)/documents/teachers/$(request.auth.uid));
    }

    // 데이터 검증 유틸
    function validString(field, maxLen) {
      return field is string && field.size() <= maxLen;
    }

    // ===== 전자칠판 표시 페이지는 인증 없이 읽기 가능 =====

    // 공지사항 (관리자 전용 쓰기)
    match /announcements/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 학급 게시판
    // 담임 PIN 로그인은 익명 인증을 사용하므로 isLoggedIn으로 허용
    // (서버 사이드 학급 분리는 Cloud Functions 도입 시 추가 가능)
    // 데이터 검증: title/content 길이 제한
    match /classAnnouncements/{id} {
      allow read: if true;
      allow create: if isLoggedIn()
        && validString(request.resource.data.title, 200)
        && validString(request.resource.data.content, 5000);
      allow update: if isLoggedIn()
        && validString(request.resource.data.title, 200)
        && validString(request.resource.data.content, 5000);
      allow delete: if isLoggedIn();
    }

    // 시간표 (기초)
    match /timetable/{classId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 일일 시간표 변경 (날짜별 오버라이드)
    // 관리자 + 담임교사가 변경 (담임은 익명 인증)
    match /timetableOverrides/{date} {
      allow read: if true;
      allow write: if isLoggedIn();
    }

    // 긴급 공지 (관리자 전용)
    match /emergency/{docId} {
      allow read: if true;
      allow write: if isAdmin()
        && (!('title' in request.resource.data) || validString(request.resource.data.title, 200))
        && (!('message' in request.resource.data) || validString(request.resource.data.message, 5000));
    }

    // 긴급 공지 이력 (관리자 전용)
    match /emergencyHistory/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // 설정 (수업시간, 급식시간, 학교설정, 운영기간, 오버라이드)
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 학급별 재적 인원·공번 (시험 결시 현황용) — 문서 ID "1-9", { count, vacant: [15, 22] }
    // 읽기: 전자칠판(비로그인)에서 재적·응시 수 표시 (숫자·번호만, 이름 없음)
    // 쓰기: 관리자만 (2026-10-14 시험 연동 중지하며 잠금 — 익명 로그인 쓰기 차단)
    match /classEnrollment/{classId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.count is int
        && request.resource.data.count >= 0
        && request.resource.data.count <= 60
        && (!('vacant' in request.resource.data)
            || (request.resource.data.vacant is list && request.resource.data.vacant.size() <= 60));
      allow delete: if isAdmin();
    }

    // 시험 결시 기록 (학생 이름·사유 = 개인정보)
    // 2026-10-14 시험 연동 중지하며 잠금: 읽기·쓰기 모두 관리자(이메일 로그인)만
    //   ※ 다시 쓰려면 PIN 서버 확인(Cloud Functions) 등 보완 후 규칙 재설계 필요
    match /examAbsents/{id} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.date is string
        && request.resource.data.classKey is string
        && request.resource.data.no is int
        && (!('name' in request.resource.data) || validString(request.resource.data.name, 30));
      allow delete: if isAdmin();
    }

    // 학급별 학생 명단 (번호 → 이름) — 문서 ID "1-9" (개인정보)
    // 2026-10-14 잠금: 익명 로그인은 누구나 가능해 보호가 안 되므로 관리자만 읽기
    match /classRosters/{classId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // 단축 수업 일 — 특정 날짜의 교시 시각 오버라이드
    match /classTimeOverrides/{date} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // D-Day 카운터
    match /dDays/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 학사일정
    match /schoolEvents/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 관리자 초대 (pendingAdmins)
    // 관리자가 새 관리자를 등록할 때 사용. 새 관리자가 첫 로그인 시
    // 이 컬렉션에 자신의 이메일이 있으면 teachers/{uid} 문서를 자가 생성할 수 있음.
    match /pendingAdmins/{email} {
      allow read: if isLoggedIn() && (isAdmin() || request.auth.token.email == email);
      allow create, delete: if isAdmin();
      allow update: if false;
    }

    // 교사 컬렉션
    // 읽기: 익명 포함 로그인 사용자 (담임 PIN 로그인용 — name/grade/class 매칭)
    //       ⚠️ 알려진 한계: pinHash가 익명 사용자에게도 노출됨
    //       (Cloud Function PIN 검증으로 마이그레이션 권장)
    // 쓰기:
    //   - create:
    //       (a) 관리자는 임의 docId/역할로 등록 가능 (.add() 랜덤 ID 포함)
    //       (b) 본인 uid 문서로 self-create 가능
    //           · role=teacher 또는 미지정 → 항상 허용
    //           · role=admin → pendingAdmins/{email} 초대가 있을 때만 허용
    //   - update/delete: 관리자 또는 본인
    match /teachers/{docId} {
      allow read: if isLoggedIn();
      allow create: if isAdmin()
        || (isLoggedIn() && request.auth.uid == docId
            && (!('role' in request.resource.data)
                || request.resource.data.role == 'teacher'
                || (request.resource.data.role == 'admin'
                    && !isAnonymous()
                    && exists(/databases/$(database)/documents/pendingAdmins/$(request.auth.token.email)))));
      allow update: if isAdmin()
        || (request.auth.uid == docId
            && !isAnonymous()
            && (!('role' in request.resource.data)
                || request.resource.data.role == resource.data.role));
      allow delete: if isAdmin();
    }
  }
}
